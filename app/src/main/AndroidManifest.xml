<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms are re-armed after a reboot; nothing else survives one. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Exact alarms, and not for precision as such.
         Both setAndAllowWhileIdle and setExactAndAllowWhileIdle are throttled to roughly
         one firing every nine minutes in Doze, so exactness buys nothing on the clock.
         What it buys is the other half of the rule: a broadcast delivered by an exact
         alarm is exempt from the Android 12 restriction on starting a foreground service
         from the background. Without it PollReceiver's handover to LiveTicker was refused
         on a sleeping phone, which is the one moment the ticker exists for, and the
         app quietly stayed on the nine-minute floor for the whole game.
         USE_EXACT_ALARM is granted at install from API 33; SCHEDULE_EXACT_ALARM covers
         the phones below that and is capped so the two never both apply. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Optional and never assumed: an app the user has taken out of battery optimisation
         is not in Doze at all, so the nine-minute floor stops existing and alarms land on
         time even when the ticker cannot run. Asked for from Settings, never at launch. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The live ticker. A foreground service is the only scheduling mechanism on this
         phone that Doze does not throttle to a nine-minute floor, which is what makes a
         30-60 second poll during a game possible at all. specialUse rather than dataSync
         because dataSync is capped at six hours a day from API 35 and a Saturday of
         college football is longer than that; the ticker caps itself instead, in
         TickerPlan.MAX_RUNTIME. The wakelock is held across the fetch only. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Not for drawing over other apps as such: on Android 14 this appop is also what
         exempts the app from background-activity-start restrictions, which is the only
         way a sideloaded app gets the box up while the screen is off. Granted by adb,
         since LightOS has no Settings screen for it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- BrightControl, so `getPackageInfo` can answer whether it is still installed. It draws
         the on-screen box for every app now and tells this one to stand down; a remembered
         claim from an app that has since been removed would silence this app's box for good.
         See notify/AlertOwner.kt. -->
    <queries>
        <package android:name="com.gios.lightcontrol" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Sports"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightSports">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Sports"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LightSports">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The score box for the screen-off and locked cases. Floating and sized to its
             content (see ScoreAlertActivity), excluded from recents, never left in the
             back stack. singleTop so a burst of scores re-uses one instance. -->
        <activity
            android:name=".notify.ScoreAlertActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.LightSports.Alert" />

        <!-- BrightControl saying whether it is drawing the on-screen box for every app.
             Exported because the sender is another app, and it must be: BrightControl addresses
             it with setPackage, which still needs the receiver reachable across the UID boundary.

             Nothing here is trusted with anything. The only thing this can do is stop this app
             drawing its own box; the buzz and the notification are never gated on it, so a forged
             broadcast costs a box and cannot silence a score. See notify/AlertOwner.kt. -->
        <receiver
            android:name=".notify.AlertOwnerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.gios.lightcontrol.action.ALERTS_OWNED" />
            </intent-filter>
        </receiver>

        <!-- The scoreboard poll. Not exported: only this app's own alarm triggers it. -->
        <receiver
            android:name=".notify.PollReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gios.lightsports.POLL" />
            </intent-filter>
        </receiver>

        <!-- Runs only while a followed team is actually playing, and stops itself at the
             final whistle. See LiveTicker. -->
        <service
            android:name=".notify.LiveTicker"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Polls a live sports scoreboard every 30-60 seconds while a followed game is in progress, and stops when it ends." />
        </service>

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
